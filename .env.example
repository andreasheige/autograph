# --- Autograph Configuration Template ---

# The absolute path to your Obsidian Vault
AUTOGRAPH_VAULT_ROOT=/path/to/your/vault

# The directory to start scanning for Git repositories
AUTOGRAPH_SEARCH_DIR=/path/to/your/projects

# The name of the model to use in Ollama (e.g., 'llama3')
AUTOGRAPH_MODEL_NAME=llama3

# The local URL for Ollama API
AUTOGRAPH_OLLAMA_URL=http://localhost:11434/api/generate

# Path to store logs
AUTOGRAPH_LOG_DIR=/path/to/your/logs
