# --- Autograph Configuration Template ---

# The absolute path to your Obsidian Vault
AUTOGRAPH_VAULT_ROOT=/path/to/your/vault

# The directory to start scanning for Git repositories
AUTOGRAPH_SEARCH_DIR=/path/to/your/projects

# The name of the model to use in Ollama
AUTOGRAPH_MODEL_NAME=deepseek-v3

# The local URL for Ollama API
AUTOGRAPH_OLLAMA_URL=http://localhost:11434/api/generate

# Maximum number of seconds to wait for a local model response
AUTOGRAPH_OLLAMA_TIMEOUT_SECONDS=300

# Path to store logs
AUTOGRAPH_LOG_DIR=/path/to/your/logs

# Session observation settings
AUTOGRAPH_SESSION_DRIVERS=shell,copilot,claude,codex,pi
AUTOGRAPH_SESSION_LOG_FILE=~/autograph_session.log
AUTOGRAPH_SESSION_CURSOR_PATH=~/.autograph/session_cursors.json
AUTOGRAPH_COPILOT_SESSION_ROOT=~/.copilot/session-state
AUTOGRAPH_CLAUDE_SESSION_ROOT=~/.claude
AUTOGRAPH_CODEX_SESSION_ROOT=~/.codex
AUTOGRAPH_PI_SESSION_ROOT=~/.pi/agent/sessions
